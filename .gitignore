# --- Secrets (CLAUDE.md §6: KHÔNG commit secrets ngay từ đầu) ---
.env
.env.*
!.env.example
application-secrets.yml
application-secrets.yaml
*.pem
*.key

# --- services/api (Gradle / Java) ---
services/api/build/
services/api/.gradle/
services/api/out/
services/api/bin/

# --- apps/mobile (Expo / Node) ---
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/metro.log

# --- log tạm sinh ra khi chạy backend local (bootRun) qua nohup/background — không phải log thật của
#     app, chỉ là output tool trong lúc dev/test (nhiều lần đặt tên bootrun2.log, bootrun3.log... khi
#     restart lặp lại) ---
services/api/bootrun*.log

# --- Claude Code local-only (skills-lock.json + .agents/skills ARE committed — see CLAUDE.md;
#     .claude/skills/* are symlinks with absolute paths generated by `npx skills add`, machine-specific,
#     regenerate locally after clone; settings.local.json is per-dev permission approvals) ---
.claude/settings.local.json
.claude/skills/

