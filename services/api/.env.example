# Copy thành .env (đã gitignore) và điền giá trị thật. Không commit file .env.
# Xem CLAUDE.md §6 "Không commit secrets".

DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# Chuỗi ngẫu nhiên đủ dài (>= 32 ký tự) để ký JWT — KHÔNG dùng giá trị mặc định trong application.yml ở production
JWT_SECRET=

# 86400000 ms = 1 ngày (docs/adr/0004-auth-simplified-for-v1.md)
JWT_EXPIRATION_MS=86400000

PORT=8080

# Tài khoản Claude API (console.anthropic.com) — KHÁC tài khoản Supabase ở trên. Dùng cho OCR ảnh phiếu
# (docs/adr/0005-synchronous-ocr-call.md). Chưa cần điền ở giai đoạn Supabase setup — chỉ cần khi bắt
# tay code tích hợp OCR (Phase 3 trong docs/TASKS.md).
ANTHROPIC_API_KEY=
