{
  "expo": {
    "name": "Mycompany — Sản lượng cao su",
    "slug": "mycompany-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mycompanymobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép chụp ảnh phiếu giấy để đọc bằng AI (CLAUDE.md §5)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh phiếu giấy có sẵn (vd Tổ trưởng gửi qua Zalo) để đọc bằng AI."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Cho phép dùng Face ID để đăng nhập nhanh, thay vì gõ lại email/mật khẩu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
